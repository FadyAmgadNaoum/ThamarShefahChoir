# ==============================================================================
# Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development. Never commit real credentials!

# Database connection URL
DATABASE_URL="file:local.db"

# Session encryption key (Use a minimum 32-character high-entropy random string)
AUTH_SECRET=""

# Google Gemini API key (Optional: system automatically falls back to offline heuristic classifier)
GEMINI_API_KEY=""

# Cloudflare Turnstile Bot Protection (Optional for local development)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Initial Admin Seeding (Used only on initial database initialization)
INITIAL_ADMIN_EMAIL="admin@example.org"
INITIAL_ADMIN_PASSWORD=""
